# PixelTavern API 环境变量配置
# 复制此文件为 .env 并填入实际值

# 默认 OpenAI-compatible API 地址。可以填 http://localhost:11434/v1、https://api.openai.com/v1
# 或 https://api.deepseek.com；后端会自动拼接 chat/completions，避免重复 /v1。
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama
OPENAI_COMPATIBLE_MODEL=qwen2.5:7b

# 世界运行可选独立模型配置；为空时使用上面的默认配置或 UI 保存的配置。
WORLD_MODEL_BASE_URL=
WORLD_MODEL_API_KEY=
WORLD_MODEL=

# API 服务端口
API_PORT=8000

# LLM 请求超时（秒）
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.5

# 游戏日历：每轮 30 秒，6 轮 = 1 天，因此默认 180 秒/天
CALENDAR_START=1500-01-01
SECONDS_PER_DAY=180
